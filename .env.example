# Copy to .env and fill in. Never commit .env - it is gitignored, and the
# deploy uploads the repo root to the server.
#
# APP_KEY must be present (even empty) before running `php artisan key:generate`:
# Laravel 5.2 generates the key by string-replacing this line, so on a file
# without it the command silently writes nothing.

APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_LOG=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=botkeeping
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync
BROADCAST_DRIVER=log

MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
